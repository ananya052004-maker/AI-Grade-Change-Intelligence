# Python -- depth-agnostic (**/) so these match no matter how deep the
# actual project folder sits relative to the repo root
**/.venv/
**/__pycache__/
*.pyc

# Node
**/node_modules/
**/dist/

# Generated data / db / model artifacts
**/*.parquet
**/data/*.csv
**/*.db
**/model_registry/

# OS
.DS_Store
